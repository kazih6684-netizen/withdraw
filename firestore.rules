rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Team Members collection
    match /teamMembers/{memberId} {
      allow read, write: if true;
    }

    // Requests collection
    match /requests/{requestId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    function isValidTeamMember(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.role is string && data.role in ['leader', 'trainer'];
    }

    function isValidRequest(data) {
      return data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && data.recipientName is string && data.recipientName.size() > 0 && data.recipientName.size() <= 100
        && data.amount is number && data.amount >= 0 && data.amount < 1000000
        && data.status is string && data.status in ['pending', 'approved', 'rejected'];
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
